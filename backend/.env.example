DB_HOST=localhost
DB_PORT=3306
DB_NAME=sanjuan
DB_USER=produccion
DB_PASS=

JWT_SECRET=
HASH_SECRET=

# ADMIN_PASS / EXPENDIO_PASS sólo se usan UNA vez, en el primer arranque,
# para sembrar la tabla `usuarios` con los usuarios admin/expendio iniciales.
# Después la gestión se hace desde el panel /admin/usuarios y estas vars
# pueden eliminarse. La tabla se crea con backend/migrations/001_usuarios.sql.
ADMIN_USER=admin
ADMIN_PASS=
EXPENDIO_PASS=

PORT=3001

# --- Bancard / Ventas QR (Infonet) ---
# Sandbox: https://desa.infonet.com.py:8035/external-commerce/api/0.1
# Las credenciales las provee Bancard por comercio/sucursal.
BANCARD_ENV=sandbox
BANCARD_BASE_URL=https://desa.infonet.com.py:8035/external-commerce/api/0.1
BANCARD_COMMERCE_CODE=270020
BANCARD_BRANCH_CODE=2
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
# true sólo en sandbox (cert de desa puede no validar). En producción: false/vacío.
BANCARD_INSECURE_TLS=true
# Basic Auth con que Bancard invoca el callback. Vacío = no se valida.
BANCARD_CALLBACK_USER=
BANCARD_CALLBACK_PASS=

# --- RTS (servidor realtime Socket.IO) para despacho por estaciones ---
# Notifica a las pantallas de estación cuando el lector QR rutea un pedido.
RTS_URL=https://rts.nuova.com.py
# DEBE coincidir con el INTERNAL_SECRET del RTS en el droplet. Vacío = no notifica
# (la cola en la base igual funciona, solo que sin aviso en vivo).
RTS_INTERNAL_SECRET=
