DB_HOST=localhost
DB_PORT=3306
DB_NAME=sanjuan
DB_USER=produccion
DB_PASS=

JWT_SECRET=
HASH_SECRET=

# ADMIN_PASS / EXPENDIO_PASS sólo se usan UNA vez, en el primer arranque,
# para sembrar la tabla `usuarios` con los usuarios admin/expendio iniciales.
# Después la gestión se hace desde el panel /admin/usuarios y estas vars
# pueden eliminarse. La tabla se crea con backend/migrations/001_usuarios.sql.
ADMIN_USER=admin
ADMIN_PASS=
EXPENDIO_PASS=

PORT=3001

BANCARD_ENV=sandbox
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
